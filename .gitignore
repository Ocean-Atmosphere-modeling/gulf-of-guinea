# ROMS build output (made by run/build_roms.sh)
Build_roms*/
romsM
romsG
romsO
romsS
build.log

# SLURM job logs
out.slurm.*
err.slurm.*

# Python cache
__pycache__/
*.pyc

# Driver step logs
logs/
*.log

# ROMS settings files written per cycle by python/make_roms_in.py.
# The template run/roms_gulfofguinea.in IS tracked; these dated copies are
# rebuilt every run and do not need to be stored.
run/roms_gulfofguinea_*.in
